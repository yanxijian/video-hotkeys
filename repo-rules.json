{
  "version": 1,
  "skip_dirs": [
    ".git"
  ],
  "skip_prefixes": [],
  "skip_globs": [],
  "encoding": [
    {
      "glob": "*.js",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "scripts/repo_rules.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/pre-commit",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/commit-msg",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [],
    "limit": 140,
    "tab_width": 2
  },
  "forbidden": [],
  "headers": {
    "globs": [],
    "first_line": "#pragma once",
    "forbid_namespace_using": true
  },
  "versions": [],
  "changelog": null,
  "required_files": [
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "LICENSE",
    "video-hotkeys.user.js",
    "repo-rules.json",
    ".gitattributes",
    "scripts/repo_rules.py",
    ".githooks/pre-commit",
    ".githooks/commit-msg",
    ".github/workflows/hygiene.yml"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.zh-CN.md",
        "README.ja.md",
        "README.ko.md"
      ],
      "switch_line": true,
      "stale": "warning"
    }
  },
  "readme_badges": {
    "files": [
      "README.md",
      "README.zh-CN.md",
      "README.ja.md",
      "README.ko.md"
    ],
    "min": 3,
    "require": [
      "actions/workflows/",
      "img.shields.io/badge/License"
    ]
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto eol=lf",
      "\\*\\.js\\s+text eol=lf",
      "\\*\\.md\\s+text eol=lf",
      "\\*\\.json\\s+text eol=lf",
      "\\*\\.yml\\s+text eol=lf"
    ]
  },
  "about": {
    "description": "Universal keyboard controls for any HTML5 video | 给任意网页视频补上键盘控制的用户脚本",
    "order": "en-zh"
  },
  "commit_message": {
    "english": true
  },
  "actions": {
    "require": {
      "actions/checkout": "v7"
    },
    "allow_sha": true
  }
}
